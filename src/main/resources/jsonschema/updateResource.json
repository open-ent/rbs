{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"type": "object",
	"properties": {
		"name": {
			"type": "string"
		},
		"description": {
			"type": "string"
		},
		"icon": {
			"type": "string"
		},
		"periodic_booking": {
			"type": "boolean"
		},
		"is_available": {
			"type": "boolean"
		},
		"was_available": {
			"description" : "Previous value of is_available" ,
			"type": "boolean"
		},
		"min_delay": {
			"type": "integer",
			"minimum": -1
		},
		"max_delay": {
			"type": "integer",
			"minimum": -1
		},
		"type_id": {
			"type": "integer"
		},
		"color": {
			"type": ["string", "null"]
		},
		"validation": {
			"type": "boolean"
		},
		"quantity": {
			"type": "integer"
		},
		"capacity": {
			"description": "Capacité d'accueil de la salle (nombre de places), distincte de quantity",
			"type": ["integer", "null"],
			"minimum": 0
		},
		"is_mobile": {
			"description": "Matériel mobile (chariot, vidéoprojecteur mobile) plutôt qu'une salle fixe",
			"type": "boolean"
		},
		"requires_key": {
			"description": "Accès à la ressource nécessitant une clé",
			"type": "boolean"
		}
	},
	"required": [
		"type_id",
		"is_available",
		"was_available"
	],
	"additionalProperties" : false
}