{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "validation": {
      "type": "boolean"
    },
    "school_id": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "extendcolor": {
      "type": "boolean"
    },
    "slotprofile": {
      "type": "string"
    },
    "category": {
      "description": "Catégorie fonctionnelle de salle, pour le matching salle/matière (school-planner, EDT). Texte libre : quelques catégories usuelles sont suggérées côté IHM, mais un établissement peut en créer de nouvelles.",
      "type": "string",
      "maxLength": 40
    }
  },
  "required": [
      "name",
      "validation",
      "color"
    ]
}
